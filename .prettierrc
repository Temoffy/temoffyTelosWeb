{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 90,
	"plugins": ["prettier-plugin-svelte"],
	"overrides": [
		{
			"files": ["*.svelte"],
			"options": {
				"parser": "svelte",
				"defaultScriptLanguage": "ts",
				"singleQuote": true,
				"svelteSortOrder": "options-scripts-styles-markup"
			}
		},
		{
			"files": ["*.svx"],
			"options": {
				"parser": "markdown",
				"printWidth": 80,
				"proseWrap": "always"
			}
		}
	]
}
